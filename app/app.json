{
  "expo": {
    "name": "GakuPres",
    "slug": "gakupres",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.gakupres.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gakupres.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-adaptive.png",
        "backgroundColor": "#ffffff"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": []
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "GakuPres uses the camera to scan student ID QR codes for attendance.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GakuPres uses your photos so you can pick a profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon-dark.png",
          "imageWidth": 140,
          "backgroundColor": "#fff8ec"
        }
      ],
      "expo-secure-store",
      "./plugins/withPhoneArchs"
    ],
    "extra": {
      "eas": {
        "projectId": "ab2040e4-63bd-48e0-b736-61cb79110041"
      }
    }
  }
}
