# true  = fake data, no server needed (works only while developing)
# false = talk to the real backend
EXPO_PUBLIC_USE_MOCK=true

# Your computer's address as seen by the PHONE (same wifi). NOT localhost!
# Windows: run `ipconfig` | Mac/Linux: run `ifconfig` or `ip a` -> look for 192.168.x.x
# Android emulator: http://10.0.2.2:5000/api | iOS simulator: http://localhost:5000/api
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api
