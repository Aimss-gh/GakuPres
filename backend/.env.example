MONGO_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/gakupres
# 32+ random characters. Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_secret_key_here
PORT=5000
# minutes after a class starts that a scan still counts as Present (later = Late)
LATE_AFTER_MINUTES=15
# only behind a proxy/host (Render, Railway, nginx): 1
# TRUST_PROXY=1

# Email for "Forgot password" codes. Gmail: turn on 2-Step Verification, then create an App password
# (Google Account > Security > App passwords) and put it in SMTP_PASS. Empty = codes are printed in this
# terminal instead (fine for testing; a production server refuses reset requests until this is set).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GakuPres <gakupres+support@gmail.com>"

# Where feedback from the app is emailed. Empty = SMTP_USER (the team inbox).
# FEEDBACK_TO=gakupres@gmail.com
